name: Daily Stock Screener Cron Job

on:
  schedule:
    # 10:30 UTC = 4:00 PM IST (Monday through Friday)
    - cron: '30 10 * * 1-5'
  workflow_dispatch: # Allows manual trigger button in GitHub

jobs:
  run-screener:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v3

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Install Dependencies
        run: |
          pip install pandas "numpy<2" yfinance

      - name: Execute screener_1.py
        run: python screener_1.py

      - name: Commit and Push Updated Database
        run: |
          git config --global user.name 'Automated Bot'
          git config --global user.email 'bot@github.com'
          git add trades.db
          git commit -m "Auto-update trades.db [Skip CI]" || exit 0
          git push
